{
  "id": "anime-fed46cbe11a0f40c2978",
  "type": "anime",
  "title": "小书痴的下克上 领主的养女",
  "original_title": "xiaoshuchidexiakeshanglingzhudeyangnv",
  "year": 2026,
  "category": "日韩动漫",
  "section": "regular",
