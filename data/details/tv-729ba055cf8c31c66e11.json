{
  "id": "tv-729ba055cf8c31c66e11",
  "type": "tv",
  "title": "师尊去哪了：变成神兽被五个徒儿rua秃",
  "original_title": "shizunqunaliaobianchengshenshoubeiwugetuerruatu",
  "year": 2026,
  "category": "中国动漫",
