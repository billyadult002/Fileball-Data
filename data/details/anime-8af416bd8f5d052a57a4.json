{
  "id": "anime-8af416bd8f5d052a57a4",
  "type": "anime",
  "title": "骸骨骑士大人异世界冒险中第二季",
  "original_title": "haiguqishidarenyishijiemaoxianzhongdierji",
  "year": 2026,
